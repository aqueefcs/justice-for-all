# ---------------------------------------------------------------------------
# Justice For All API — copy to .env for local development. Never commit .env.
# In AWS these come from SSM Parameter Store (/jfa/<stage>/...) via the CDK stack.
# Integrations with empty values run as safe placeholders (see docs/integrations.md).
# ---------------------------------------------------------------------------

# Core
STAGE=local                     # local | dev | prod
PORT=3000
APP_VERSION=0.1.0
LOG_LEVEL=debug
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# MongoDB (local: `pnpm db:up`; cloud: Atlas M0 on AWS ap-south-1)
MONGODB_URI=mongodb://localhost:27017/jfa?replicaSet=rs0
MONGODB_MAX_POOL_SIZE=5

# Cloudflare → API origin lock (set in Cloudflare Transform Rule + here). Empty = disabled (local only).
ORIGIN_VERIFY_SECRET=

# Auth — Better Auth (Phase 1: staff email+2FA; Phase 2: citizen phone OTP + Google)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development only: allow `x-dev-role` header to impersonate a role. NEVER true outside local.
ALLOW_DEV_AUTH=true

# Storage — Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=jfa-private-local
R2_PUBLIC_BUCKET=jfa-content-local
CONTENT_CDN_URL=

# Queue — AWS SQS (empty = jobs run inline in-process)
AWS_REGION=ap-south-1
JOBS_QUEUE_URL=

# Email — Amazon SES
SES_FROM_EMAIL=

# SMS OTP — MSG91 (Phase 2; India DLT registration required)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Push — Expo Push (Phase 2)
EXPO_ACCESS_TOKEN=

# Payments — Razorpay (Phase 3)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Video — 100ms (Phase 3)
HMS_ACCESS_KEY=
HMS_SECRET=
HMS_TEMPLATE_ID=

# Translation — Bhashini (machine drafts; lawyer review required)
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Malware scanning — ClamAV worker (Phase 2)
MALWARE_SCAN_ENABLED=false

# Observability
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
