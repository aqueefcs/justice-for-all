{
  "name": "@jfa/api",
  "version": "0.1.0",
  "private": true,
  "description": "Justice For All REST API (NestJS + Fastify): runs locally, on AWS Lambda (Web Adapter) or in a container",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "node scripts/export-openapi.mjs",
    "bundle:lambda": "nest build && node scripts/bundle-lambda.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/client-sesv2": "3.1163.0",
    "@aws-sdk/client-sqs": "3.1163.0",
    "@aws-sdk/client-ssm": "3.1163.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.10",
    "@jfa/db": "workspace:*",
    "@jfa/shared": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-fastify": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "fastify": "5.12.8",
    "mongoose": "9.12.0",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jfa/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.22",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "mongodb-memory-server": "11.3.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
