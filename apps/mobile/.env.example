# Copy to .env for local development. Only EXPO_PUBLIC_* values reach the app bundle —
# they are PUBLIC (visible in the APK). Never put secrets here.

EXPO_PUBLIC_STAGE=local
# API base URL, e.g. http://192.168.1.10:3000 (your PC's LAN IP when testing on a phone)
EXPO_PUBLIC_API_URL=
# Public content CDN (Cloudflare R2), e.g. https://content.<domain>. Empty = bundled SAMPLE pack only.
EXPO_PUBLIC_CONTENT_CDN_URL=

# Placeholders (wired in src/integrations/*)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Used by app.config.ts after `eas init` (not EXPO_PUBLIC — build-time only)
EAS_PROJECT_ID=
