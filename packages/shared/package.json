{
  "name": "@jfa/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas (single source of truth), roles, locales and shared utils",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jfa/config": "workspace:*",
    "tsup": "9.0.0",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
