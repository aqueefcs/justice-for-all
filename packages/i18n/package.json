{
  "name": "@jfa/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "UI translation resources for mobile and admin (i18next)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-keys.mjs"
  },
  "devDependencies": {
    "@jfa/config": "workspace:*",
    "tsup": "9.0.0",
    "typescript": "~6.0.3"
  }
}
