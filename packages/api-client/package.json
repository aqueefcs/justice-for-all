{
  "name": "@jfa/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed API client generated from apps/api/openapi.json — never hand-edit src/schema.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/schema.d.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@jfa/config": "workspace:*",
    "openapi-typescript": "7.13.0",
    "tsup": "9.0.0",
    "typescript": "~6.0.3"
  }
}
